generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
  MIGRATION_REQUIRED
}

enum EmailChallengePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

model User {
  id                  String                       @id @default(cuid())
  name                String
  email               String
  normalizedEmail     String                       @unique
  emailVerifiedAt     DateTime?
  pendingEmail        String?
  legacyPhoneE164     String?                      @unique
  passwordHash        String
  role                UserRole                     @default(STUDENT)
  status              UserStatus                   @default(PENDING_VERIFICATION)
  failedLoginAttempts Int                          @default(0)
  lockedUntil         DateTime?
  sessionVersion      Int                          @default(1)
  passwordChangedAt   DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  purchases           Purchase[]
  enrollments         Enrollment[]
  emailChallenges     EmailVerificationChallenge[]
  sessions            Session[]
  auditLogs           SecurityAuditLog[]           @relation("AuditSubject")
  actorAuditLogs      SecurityAuditLog[]           @relation("AuditActor")
  instructedCourses   Course[]                     @relation("CourseInstructor")

  @@index([status, role])
  @@index([lockedUntil])
}

model Course {
  id                    String         @id @default(cuid())
  slug                  String         @unique
  titleEn               String
  titleAr               String
  shortDescriptionEn    String
  shortDescriptionAr    String
  fullDescriptionEn     String
  fullDescriptionAr     String
  instructor            String
  instructorId          String?
  priceCents            Int
  currency              String         @default("USD")
  image                 String
  accent                String
  telegramAccessUrl     String?
  telegramButtonLabelEn String?
  telegramButtonLabelAr String?
  status                CourseStatus   @default(DRAFT)
  publishedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  purchaseItems         PurchaseItem[]
  enrollments           Enrollment[]
  instructorUser        User?          @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([instructorId])
}

model Purchase {
  id                String               @id @default(cuid())
  userId            String
  provider          String
  providerSessionId String               @unique
  status            PaymentStatus        @default(PENDING)
  amountCents       Int
  currency          String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  paidAt            DateTime?
  providerPaymentId String?              @unique
  expectedAmount    Decimal?             @db.Decimal(30, 12)
  receivedAmount    Decimal?             @db.Decimal(30, 12)
  payCurrency       String?
  network           String?
  paymentAddress    String?
  transactionHash   String?
  providerStatus    String?
  expiresAt         DateTime?
  rawWebhookHash    String?
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             PurchaseItem[]
  transactions      PaymentTransaction[]
  enrollments       Enrollment[]

  @@index([userId, status])
}

model PurchaseItem {
  purchaseId String
  courseId   String
  priceCents Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([purchaseId, courseId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  purchaseId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId])
}

model PaymentTransaction {
  id          String         @id @default(cuid())
  purchaseId  String
  eventId     String         @unique
  fromStatus  PaymentStatus?
  toStatus    PaymentStatus
  payloadHash String
  createdAt   DateTime       @default(now())
  purchase    Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String    @id
  provider    String
  payloadHash String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([provider, receivedAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model EmailVerificationChallenge {
  id            String                @id @default(cuid())
  userId        String
  email         String
  purpose       EmailChallengePurpose
  codeHash      String
  attempts      Int                   @default(0)
  maxAttempts   Int                   @default(5)
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

model Session {
  id        String    @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  actorId   String?
  action    String
  ipHash    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation("AuditSubject", fields: [userId], references: [id], onDelete: SetNull)
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
