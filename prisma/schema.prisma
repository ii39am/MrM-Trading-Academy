generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
  SUSPENDED
  DELETION_PENDING
  DELETED
  MIGRATION_REQUIRED
}

enum EmailChallengePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum LoginEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_RESET
  PASSWORD_CHANGED
  EMAIL_CHANGED
  SESSION_REVOKED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponRedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

model User {
  id                  String                       @id @default(cuid())
  name                String
  email               String
  normalizedEmail     String                       @unique
  emailVerifiedAt     DateTime?
  pendingEmail        String?
  legacyPhoneE164     String?                      @unique
  passwordHash        String
  role                UserRole                     @default(STUDENT)
  status              UserStatus                   @default(PENDING_VERIFICATION)
  failedLoginAttempts Int                          @default(0)
  lockedUntil         DateTime?
  sessionVersion      Int                          @default(1)
  passwordChangedAt   DateTime?
  preferredLanguage   String                       @default("en")
  lastLoginAt         DateTime?
  deletionRequestedAt DateTime?
  deletedAt           DateTime?
  deletedByUserId     String?
  deletionReason      String?
  anonymizedAt        DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  purchases           Purchase[]
  enrollments         Enrollment[]
  emailChallenges     EmailVerificationChallenge[]
  sessions            Session[]
  loginEvents         LoginEvent[]
  couponRedemptions   CouponRedemption[]
  createdCoupons      Coupon[]                     @relation("CouponCreator")
  auditLogs           SecurityAuditLog[]           @relation("AuditSubject")
  actorAuditLogs      SecurityAuditLog[]           @relation("AuditActor")
  instructedCourses   Course[]                     @relation("CourseInstructor")

  @@index([status, role])
  @@index([lockedUntil])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@index([deletionRequestedAt])
}

model Course {
  id                    String          @id @default(cuid())
  slug                  String          @unique
  titleEn               String
  titleAr               String
  shortDescriptionEn    String
  shortDescriptionAr    String
  fullDescriptionEn     String
  fullDescriptionAr     String
  instructor            String
  instructorId          String?
  priceCents            Int
  currency              String          @default("USD")
  image                 String
  accent                String
  telegramAccessUrl     String?
  telegramButtonLabelEn String?
  telegramButtonLabelAr String?
  status                CourseStatus    @default(DRAFT)
  publishedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  purchaseItems         PurchaseItem[]
  enrollments           Enrollment[]
  couponProducts        CouponProduct[]
  instructorUser        User?           @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([instructorId])
}

model Purchase {
  id                  String               @id @default(cuid())
  userId              String
  provider            String
  providerSessionId   String               @unique
  status              PaymentStatus        @default(PENDING)
  amountCents         Int
  currency            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  paidAt              DateTime?
  providerPaymentId   String?              @unique
  expectedAmount      Decimal?             @db.Decimal(30, 12)
  receivedAmount      Decimal?             @db.Decimal(30, 12)
  payCurrency         String?
  network             String?
  paymentAddress      String?
  transactionHash     String?
  providerStatus      String?
  expiresAt           DateTime?
  rawWebhookHash      String?
  originalAmountCents Int                  @default(0)
  discountAmountCents Int                  @default(0)
  couponId            String?
  refundedAmountCents Int                  @default(0)
  refundedAt          DateTime?
  refundReference     String?
  refundAdminNote     String?
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items               PurchaseItem[]
  transactions        PaymentTransaction[]
  enrollments         Enrollment[]
  coupon              Coupon?              @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponRedemption    CouponRedemption?

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([couponId, status])
}

model PurchaseItem {
  purchaseId String
  courseId   String
  priceCents Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([purchaseId, courseId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  purchaseId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId])
}

model PaymentTransaction {
  id          String         @id @default(cuid())
  purchaseId  String
  eventId     String         @unique
  fromStatus  PaymentStatus?
  toStatus    PaymentStatus
  payloadHash String
  createdAt   DateTime       @default(now())
  purchase    Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String    @id
  provider    String
  payloadHash String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([provider, receivedAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model EmailVerificationChallenge {
  id            String                @id @default(cuid())
  userId        String
  email         String
  purpose       EmailChallengePurpose
  codeHash      String
  attempts      Int                   @default(0)
  maxAttempts   Int                   @default(5)
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

model Session {
  id               String    @id
  publicId         String    @unique @default(uuid())
  userId           String
  expiresAt        DateTime
  lastSeenAt       DateTime  @default(now())
  revokedAt        DateTime?
  revocationReason String?
  userAgentSummary String?
  deviceType       String?
  browser          String?
  operatingSystem  String?
  ipHash           String?
  maskedIp         String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

model SecurityAuditLog {
  id               String    @id @default(cuid())
  userId           String?
  actorId          String?
  actorRole        UserRole?
  action           String
  category         String?
  entityType       String?
  entityId         String?
  targetUserId     String?
  ipHash           String?
  userAgentSummary String?
  metadata         Json?
  createdAt        DateTime  @default(now())
  user             User?     @relation("AuditSubject", fields: [userId], references: [id], onDelete: SetNull)
  actor            User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

model LoginEvent {
  id                String         @id @default(cuid())
  userId            String?
  eventType         LoginEventType
  success           Boolean
  ipHash            String?
  ipDisplayMasked   String?
  userAgentSummary  String?
  deviceType        String?
  browser           String?
  operatingSystem   String?
  countryCode       String?
  city              String?
  failureReasonCode String?
  createdAt         DateTime       @default(now())
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

model Coupon {
  id                    String             @id @default(cuid())
  code                  String
  normalizedCode        String             @unique
  descriptionEn         String
  descriptionAr         String
  discountType          DiscountType
  discountValue         Int
  currency              String?
  active                Boolean            @default(true)
  startsAt              DateTime?
  expiresAt             DateTime?
  totalUsageLimit       Int?
  perUserUsageLimit     Int?
  minimumOrderAmount    Int                @default(0)
  maximumDiscountAmount Int?
  createdByUserId       String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  createdBy             User               @relation("CouponCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  products              CouponProduct[]
  redemptions           CouponRedemption[]
  purchases             Purchase[]

  @@index([active, startsAt, expiresAt])
  @@index([createdAt])
}

model CouponProduct {
  couponId String
  courseId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([couponId, courseId])
  @@index([courseId])
}

model CouponRedemption {
  id             String                 @id @default(cuid())
  couponId       String
  userId         String
  purchaseId     String                 @unique
  discountAmount Int
  status         CouponRedemptionStatus @default(RESERVED)
  reservedAt     DateTime               @default(now())
  expiresAt      DateTime
  redeemedAt     DateTime?
  releasedAt     DateTime?
  coupon         Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchase       Purchase               @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([couponId, status, expiresAt])
  @@index([userId, couponId, status])
  @@index([expiresAt, status])
}
